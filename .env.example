# Port for the unified server
PORT=5000

# Environment mode (development / production)
NODE_ENV=production

# PostgreSQL Database URL (Neon, Supabase, Render, Railway, or local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/classroom_db"

# Gemini API Key (optional for basic features; required for Veo video & live transcription)
GEMINI_API_KEY="your-gemini-api-key-here"
